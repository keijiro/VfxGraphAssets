  m_OperatorName: Custom HLSL
  m_HLSLCode: "float2 DFNField2D_RandomOffset(uint seed)\n{\n  seed *= 2u;\n  return
    float2(Hash(seed), Hash(seed +1u)) * 2000 - 1000;\n}"
